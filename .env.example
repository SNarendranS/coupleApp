# =================================================================
# USTWO - COUPLES WEB APPLICATION ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to `.env` or set these variables in your hosting
# provider's dashboard (e.g., Render, Railway, Vercel, Fly.io).
# =================================================================

# -----------------------------------------------------------------
# 1. SERVER CONFIGURATION
# -----------------------------------------------------------------
# Port for the Express + Socket.IO server (Render assigns this automatically)
PORT=5000

# Environment mode: 'development', 'production', or 'test'
# Set to 'production' on Render
NODE_ENV=development

# Allowed CORS client URL.
# In local development: http://localhost:5173
# On Render (unified deployment where Express serves client/dist):
#   Set to your live Render domain, e.g. https://ustwo-app.onrender.com
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB ATLAS)
# -----------------------------------------------------------------
# Connection string from your MongoDB Atlas cluster.
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/coupleApp?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------
# High-entropy secret key for signing JWT tokens and session cookies.
# Must be at least 16 characters (recommended: 32+ random characters).
JWT_SECRET=super_secret_jwt_key_couple_app_production_ready_replace_me

# JWT token expiration duration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------
# 4. PERSISTENT MEDIA STORAGE (CLOUDINARY)
# -----------------------------------------------------------------
# Required on Render for persistent image uploads (profile photos,
# memories, calendar events). Render containers have ephemeral disks,
# so without Cloudinary, uploaded images are lost when the container sleeps.
#
# You can provide EITHER Option A (single URL) OR Option B (separate keys):
#
# OPTION A: Single URL from Cloudinary Console dashboard:
# (Dashboard -> "API Environment variable" -> copy string)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# OPTION B: Separate credentials from Cloudinary Console dashboard:
# CLOUDINARY_CLOUD_NAME=<your_cloud_name>
# CLOUDINARY_API_KEY=<your_api_key>
# CLOUDINARY_API_SECRET=<your_api_secret>

# -----------------------------------------------------------------
# 5. BACKGROUND WORKER / AUTOMATED REMINDERS (OPTIONAL)
# -----------------------------------------------------------------
# Secret token for authenticating automated cron pingers (e.g. cron-job.org,
# UptimeRobot, or Render Cron Job) calling:
# POST /api/calendar/reminders/process-due
# Header required: Authorization: Bearer <WORKER_SECRET>
# If left empty, it falls back to checking against JWT_SECRET.
WORKER_SECRET=your_background_worker_secret_key_here

# -----------------------------------------------------------------
# 6. CLIENT CONFIGURATION (VITE FRONTEND)
# -----------------------------------------------------------------
# In local development:
#   VITE_API_URL=http://localhost:5000/api
#   VITE_SOCKET_URL=http://localhost:5000
#
# On Render unified deployment (Express serves both API and Vite client):
#   VITE_API_URL=/api
#   VITE_SOCKET_URL=/
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
